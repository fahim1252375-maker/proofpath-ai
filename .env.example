# GEMINI_API_KEY: Server-only Gemini API key. Never expose it to browser code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Gemini Free-tier copilot is fail-closed until an operator verifies the API
# project's active tier and current quota in Google AI Studio. Search grounding
# and file uploads are never sent by the no-cost copilot.
AI_ENABLED="false"
AI_FREE_TIER_CONFIRMED="false"
AI_MODEL="gemini-4-hydrogen"
AI_DAILY_REQUEST_LIMIT="10"
# Keep at 0 to disable Gemini. Set only to a limit at or below the active
# per-project free quota shown in Google AI Studio. Counters persist in SQLite.
AI_GLOBAL_DAILY_LIMIT="0"
AI_MAX_OUTPUT_TOKENS="650"
AI_MAX_INPUT_LENGTH="2000"
AI_MAX_CONCURRENT_REQUESTS="2"

# APP_URL: The public base URL where ProofPath AI is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Local development placeholder only. Production requires a unique random value, 32+ characters.
SESSION_SECRET="replace-with-32-char-random-secret"

# DB_PATH: File path for persistent SQLite storage (defaults to ./data/proofpath.db).
# On Render with a paid persistent disk mounted at /var/data/proofpath, use:
# DB_PATH="/var/data/proofpath/proofpath.db"
DB_PATH="./data/proofpath.db"

# NODE_ENV: Set to "production" when deploying.
NODE_ENV="development"

# MONITORING_CRON_SECRET: At least 32 random characters. Set the same value in the Render service
# and the GitHub Actions repository secret with this exact name.
MONITORING_CRON_SECRET=""
